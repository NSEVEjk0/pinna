# Pinna environment (names only — never commit values)

# Use mainnet (chain 4217). Anything else uses the Moderato testnet (42431).
NEXT_PUBLIC_TEMPO_CHAIN=moderato

# Optional overrides
NEXT_PUBLIC_TEMPO_RPC=
NEXT_PUBLIC_TEMPO_EXPLORER=

# Optional: send a different TIP-20 token address, or open on a symbol
NEXT_PUBLIC_TIP20=
NEXT_PUBLIC_TIP20_SYMBOL=

# Fee sponsorship. Tempo pays the fee in a stablecoin, and a sponsor can pay it
# for the payer, so someone holding only the token being sent needs nothing
# else. Leave the URL blank to use Tempo's public keyless sponsor on the
# Moderato testnet (mainnet has no public sponsor — point this at your own
# Relay handler or Tempo's hosted Fee Payer API). Set SPONSOR_FEES=false to
# switch sponsorship off entirely.
NEXT_PUBLIC_FEE_PAYER_URL=
NEXT_PUBLIC_SPONSOR_FEES=

# Machine Payments Protocol. Challenges are bound to their contents with an
# HMAC, so set a secret of at least 32 bytes; without one a per-process secret
# is generated, which does not survive a restart or span replicas.
MPP_SECRET_KEY=
MPP_REALM=

# Cloud sync (leave unset and the sync page says so rather than pretending).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secrets used to sign machine-payment receipts and encrypt host keys.
HOST_KEY_SECRET=
SESSION_SECRET=
