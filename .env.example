# Pinna environment (names only — never commit values)

# Use mainnet (chain 4217). Anything else uses the Moderato testnet (42431).
NEXT_PUBLIC_TEMPO_CHAIN=moderato

# Optional overrides
NEXT_PUBLIC_TEMPO_RPC=
NEXT_PUBLIC_TEMPO_EXPLORER=

# Optional: send a different TIP-20 token address
NEXT_PUBLIC_TIP20=
